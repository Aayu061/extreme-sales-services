# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Application URL (Points to the live Vercel frontend for email confirmation links)
APP_URL=https://extreme-sales-services.vercel.app

# Firebase Firestore Service Account (Required for Production Firestore Mode)
# In Render, paste the entire raw JSON string of your service account key here:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"extreme-sales-services-8a2b1","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# SendGrid Email Integration
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
BUSINESS_EMAIL=extremess0121@gmail.com
BUSINESS_NAME="Extreme AC Sales & Services"

# Place Your Service (PYS) Dual-Platform Integration
PYS_API_BASE_URL=https://place-your-service-api.onrender.com/api/v1
PYS_API_KEY=
PYS_WEBHOOK_SECRET=
PYS_FRONTEND_URL=https://place-your-service.vercel.app

# Signed PYS intake API (POST /api/v1/ess/intakes). When BOTH are set, bookings, AMC requests,
# product enquiries and contact messages go to PYS through the signed API; when either is empty
# ESS keeps using the legacy PYS_API_KEY path. Create the key in PYS Admin (ESS_WEB client).
# The PYS base URL is taken from PYS_API_URL if set, otherwise PYS_API_BASE_URL (a trailing /api/v1 is ignored).
PYS_API_URL=
PYS_INTEGRATION_KEY_ID=
PYS_INTEGRATION_SECRET=

# Local/test only — never set these in production (Firestore users are used there)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

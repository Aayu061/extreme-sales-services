# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Application URL (Used in email templates and redirects)
# Set this to your new Render web service URL (e.g. https://your-new-app.onrender.com)
APP_URL=https://extreme-sales-services.onrender.com

# Firebase Firestore Service Account (Required for Production Firestore Mode)
# In Render, paste the entire raw JSON string of your service account key here:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# SendGrid Email Integration
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
BUSINESS_EMAIL=support@extremess.com
BUSINESS_NAME="Extreme Sales & Services"

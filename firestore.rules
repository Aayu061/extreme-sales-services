rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Extreme Sales & Services - Production Security Rules
    // All client operations flow through Express backend using Firebase Admin SDK.
    // Direct client reads and writes are denied by default to protect PII, credentials, and contracts.

    // Deny direct client access to user credentials and RBAC records
    match /users/{userId} {
      allow read, write: if false;
    }

    // Deny direct client access to service tickets and customer PII
    match /service_requests/{requestId} {
      allow read, write: if false;
    }

    // Deny direct client access to customer AMC contracts and quotas
    match /customer_amc/{subId} {
      allow read, write: if false;
    }

    // Deny direct client access to customer consultation enquiries
    match /enquiries/{enquiryId} {
      allow read, write: if false;
    }

    // Public catalog collections (products, amc_plans, feedback) are served via cached Express APIs.
    // Deny direct client writes to prevent unauthorized tampering.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /amc_plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


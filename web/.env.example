# ESS website (web/) settings. Copy to .env.local for a PC; on Vercel set them under Project -> Environment Variables.
# Never put real secrets in this file.

# PYS API base address (no trailing /api/v1 needed). On a PC with the mock: http://localhost:4010 (node dev/mock-pys.mjs)
PYS_API_URL=http://localhost:4010
# The ESS integration key issued by PYS (scopes include portal:access for customer accounts).
# The secret also salts the one-way visitor fingerprint, so per-visitor limits start fresh after a key rotation.
PYS_INTEGRATION_KEY_ID=essweb_localdev
PYS_INTEGRATION_SECRET=local-dev-secret-not-for-production

# Public address of this site (canonical links, sitemap). An http:// address also turns off the Secure flag on the
# customer sign-in cookie, which is only for local production builds.
SITE_URL=http://localhost:3000

# Admin sign-in (/admin/login) uses the PYS Supabase project. The publishable (anon) key only, never the service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Customer accounts have no setting here: PYS switches them on with PORTAL_ENABLED=true (see docs/S11b-API-CONTRACT.md).
